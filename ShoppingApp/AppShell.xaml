<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="ShoppingApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ShoppingApp.Views"
       Shell.BackgroundColor="{StaticResource Brand}"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.NavBarHasShadow="False"
       Title="FreshBasket">

    <!-- The root page. Catalogue, Details and Cart are pushed on top via registered routes. -->
    <ShellContent Route="CustomerSelectPage"
                  ContentTemplate="{DataTemplate views:CustomerSelectPage}" />
</Shell>
