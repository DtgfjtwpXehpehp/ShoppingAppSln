<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ShoppingApp.Views.CartPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShoppingApp.ViewModels"
             xmlns:models="clr-namespace:ShoppingApp.Models"
             x:DataType="vm:CartViewModel"
             Title="Your Cart"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">

    <Grid RowDefinitions="*,Auto">

        <CollectionView ItemsSource="{Binding Lines}"
                        SelectionMode="None"
                        Margin="16,12,16,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                    <Label Text="Your cart is empty" Style="{StaticResource ItemTitle}" HorizontalOptions="Center" />
                    <Label Text="Go back and add something tasty." Style="{StaticResource Muted}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CartLine">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">

                            <Label Text="{Binding ProductName}" Style="{StaticResource ItemTitle}" VerticalOptions="Center" />

                            <Button Grid.Column="1"
                                    Text="Remove"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=RemoveCommand}"
                                    CommandParameter="{Binding .}" />

                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*">
                                <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}" Style="{StaticResource Body}" />
                                <Label Grid.Column="1" Text="{Binding UnitPrice, StringFormat='@ R{0:N2}'}"
                                       Style="{StaticResource Muted}" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding LineTotal, StringFormat='R{0:N2}'}"
                                       Style="{StaticResource Price}" HorizontalOptions="End" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Total + checkout, always visible at the bottom -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16"
                StrokeShape="RoundRectangle 18,18,0,0">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Cart total" Style="{StaticResource ItemTitle}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding CartTotal, StringFormat='R{0:N2}'}"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark=#81C784}" />
                </Grid>

                <Button Text="Checkout"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CheckoutCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
