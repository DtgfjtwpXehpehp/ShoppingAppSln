<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette -->
    <Color x:Key="Brand">#2E7D32</Color>
    <Color x:Key="BrandDark">#1B5E20</Color>
    <Color x:Key="BrandSoft">#E8F5E9</Color>
    <Color x:Key="ErrorRed">#C62828</Color>

    <!-- Product card palette (from the card design) -->
    <Color x:Key="CardAccent">#7C3AED</Color>
    <Color x:Key="CardAccentLight">#A78BFA</Color>
    <Color x:Key="CardAccentMid">#8B5CF6</Color>
    <Color x:Key="CardTitleLight">#1E293B</Color>
    <Color x:Key="BadgeGreen">#10B981</Color>

    <Color x:Key="PageLight">#F5F7F4</Color>
    <Color x:Key="PageDark">#121212</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#1E1E1E</Color>
    <Color x:Key="TextLight">#1B1B1B</Color>
    <Color x:Key="TextDark">#F2F2F2</Color>
    <Color x:Key="MutedLight">#6B7280</Color>
    <Color x:Key="MutedDark">#9CA3AF</Color>
    <Color x:Key="StrokeLight">#E2E8E0</Color>
    <Color x:Key="StrokeDark">#333333</Color>

    <!-- Brushes (Border.Stroke needs a Brush, not a Color) -->
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource Brand}" />
    <SolidColorBrush x:Key="StrokeLightBrush" Color="{StaticResource StrokeLight}" />
    <SolidColorBrush x:Key="StrokeDarkBrush" Color="{StaticResource StrokeDark}" />

    <!-- Labels -->
    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    </Style>

    <Style x:Key="ItemTitle" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <Style x:Key="Price" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Brand}, Dark=#81C784}" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource ErrorRed}" />
    </Style>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StrokeLightBrush}, Dark={StaticResource StrokeDarkBrush}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    </Style>

    <!-- Product card -->
    <Style x:Key="ProductCard" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StrokeLightBrush}, Dark={StaticResource StrokeDarkBrush}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CardTitleLight}, Dark={StaticResource TextDark}}" />
    </Style>

    <Style x:Key="CardDescription" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CardTitleLight}, Dark={StaticResource TextDark}}" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="48" />
        <Style.Triggers>
            <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                <Setter Property="BackgroundColor" Value="#9E9E9E" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Brand}, Dark=#81C784}" />
        <Setter Property="BorderColor" Value="{StaticResource Brand}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ErrorRed}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>

</ResourceDictionary>
